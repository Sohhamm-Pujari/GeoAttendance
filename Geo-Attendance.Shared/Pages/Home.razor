    <!-- Top App Information & Branding Header -->

    <div class="brand-header">

        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); padding: 6px 14px; border-radius: 20px; margin-bottom: 15px;">

