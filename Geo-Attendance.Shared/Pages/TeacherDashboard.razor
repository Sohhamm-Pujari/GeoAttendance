@page "/teacherdashboard"
@attribute [Authorize(Roles = "Teacher")]
@using Geo_Attendance.Shared
@using Geo_Attendance.Shared.Data
@inject NavigationManager NavManager
@inject AppDbContext Db
@inject IJSRuntime JS

<style>
    /* Scoped Faculty Workspace Styles */
    .sidebar {
        width: 280px;
        background: var(--bg-surface);
        backdrop-filter: blur(var(--glass-blur));
        border-right: 1px solid var(--glass-border);
        padding: var(--space-xl) var(--space-lg);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .nav-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        padding: 14px 16px;
        border-radius: var(--radius-md);
        font-size: 15px;
        font-weight: 600;
        text-align: left;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .nav-btn.active {
            background: rgba(167, 139, 250, 0.15);
            color: var(--faculty);
            border: 1px solid rgba(167, 139, 250, 0.3);
        }

    .stat-card {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-lg);
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(167, 139, 250, 0.1);
        color: var(--faculty);
    }

    /* Modal Calendar Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(4px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .calendar-day {
        padding: 10px 5px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
        user-select: none;
    }

        .calendar-day.active {
            cursor: pointer;
        }

            .calendar-day.active:hover {
                transform: scale(1.05);
            }

        .calendar-day.present {
            background: rgba(52, 211, 153, 0.2);
            color: var(--success);
            border: 1px solid rgba(52,211,153,0.5);
        }

        .calendar-day.absent {
            background: rgba(248, 113, 113, 0.2);
            color: var(--danger);
            border: 1px solid rgba(248,113,113,0.5);
        }

        .calendar-day.disabled {
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            cursor: not-allowed;
            border: 1px solid transparent;
        }
</style>

<div class="app-background theme-faculty" style="overflow: hidden;">

    <!-- Professional Sidebar Navigation -->
    <aside class="sidebar">
        <div style="display: flex; align-items: center; gap: 12px; color: var(--faculty); font-size: 20px; font-weight: 800; margin-bottom: 40px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            Faculty Portal
        </div>

        <nav style="display: flex; flex-direction: column; gap: 10px; flex: 1;">
            <button class="nav-btn @(currentTab == "Overview" ? "active" : "")" @onclick="@(() => SetTab("Overview"))">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                Live Overview
            </button>
            <button class="nav-btn @(currentTab == "Analytics" ? "active" : "")" @onclick="@(() => SetTab("Analytics"))">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                Advanced Analytics
            </button>
            <button class="nav-btn @(currentTab == "Communications" ? "active" : "")" @onclick="@(() => SetTab("Communications"))">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                Class Communications
            </button>
        </nav>

        <button class="btn btn-danger" @onclick="SignOut">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Sign Out
        </button>
    </aside>

    <!-- Main Dynamic Content -->
    <main style="flex: 1; padding: 40px; overflow-y: auto; display: flex; flex-direction: column;">

        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
            <div>
                <h2 style="margin: 0; font-size: 28px; font-weight: 700;">Welcome, @(GlobalState.CurrentUser?.Name ?? "Professor")</h2>
                <p style="margin: 5px 0 0 0; color: var(--text-secondary);">Class Teacher of: @primaryClass</p>
            </div>
            <div class="badge" style="background: rgba(167, 139, 250, 0.2); color: var(--faculty); border: 1px solid rgba(167, 139, 250, 0.4);">Session Active</div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div style="background: rgba(52, 211, 153, 0.1); color: var(--success); padding: 15px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600; border: 1px solid rgba(52, 211, 153, 0.2); display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                @statusMessage
            </div>
        }

        <!-- TAB 1: LIVE OVERVIEW -->
        @if (currentTab == "Overview")
        {
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px;">
                <div class="stat-card">
                    <div class="stat-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div>
                        <div style="font-size: 24px; font-weight: 800; color: var(--text-primary);">@totalStudents</div>
                        <div style="font-size: 13px; color: var(--text-secondary);">Total Enrolled</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(52, 211, 153, 0.1); color: var(--success);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <div>
                        <div style="font-size: 24px; font-weight: 800; color: var(--success);">@presentCount</div>
                        <div style="font-size: 13px; color: var(--text-secondary);">Verified Present Today</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(248, 113, 113, 0.1); color: var(--danger);">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    </div>
                    <div>
                        <div style="font-size: 24px; font-weight: 800; color: var(--danger);">@(totalStudents - presentCount)</div>
                        <div style="font-size: 13px; color: var(--text-secondary);">Absent / Unverified</div>
                    </div>
                </div>
            </div>

            <div class="glass-panel" style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 style="margin: 0; font-size: 18px; color: var(--faculty);">Live Class Roster</h3>

                    <!-- CSV Export Control Panel -->
                    <div style="display: flex; gap: 12px; align-items: center;">
                        <select class="glass-select" @bind="csvExportPeriod" style="padding: 8px 12px; font-size: 13px; width: 130px;">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                        <button class="btn btn-primary" style="background: var(--faculty); padding: 8px 16px; font-size: 13px; display: flex; align-items: center; gap: 6px;" @onclick="ExportRoster">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            Download CSV
                        </button>
                    </div>
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Check-In Time</th>
                            <th>Status</th>
                            <th>Manual Override Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in classRoster)
                        {
                            var record = todaysRecords.FirstOrDefault(r => r.StudentId == student.UniqueId);
                            bool isPresent = record != null;

                            <tr>
                                <td style="font-family: monospace; color: var(--text-secondary);">@student.UniqueId</td>
                                <td style="font-weight: 600;">@student.Name</td>
                                <td style="color: var(--text-secondary);">@(isPresent ? record!.Timestamp.ToString("hh:mm tt") : "--:--")</td>
                                <td>
                                    <span class="badge @(isPresent ? "badge-success" : "badge-danger")">
                                        @(isPresent ? "Verified" : "Absent")
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        @if (isPresent)
                                        {
                                            <button class="btn btn-danger" style="padding: 4px 10px; font-size: 11px;" @onclick="() => ToggleAttendance(student.UniqueId, false)">Mark Absent</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary" style="background: var(--success); color: #000; padding: 4px 10px; font-size: 11px;" @onclick="() => ToggleAttendance(student.UniqueId, true)">Mark Present</button>
                                        }
                                        <!-- NEW: Edit History Button -->
                                        <button class="btn" style="background: rgba(167, 139, 250, 0.15); color: var(--faculty); padding: 4px 10px; font-size: 11px;" @onclick="() => OpenHistoryModal(student.UniqueId)">
                                            Edit History
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- TAB 2: ADVANCED ANALYTICS -->
        @if (currentTab == "Analytics")
        {
            <div class="glass-panel" style="margin-bottom: 20px;">
                <h3 style="margin: 0 0 20px 0; font-size: 18px; color: var(--faculty);">Individual Analytics</h3>
                <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                    <select class="glass-select" style="flex: 1;" @bind="selectedStudentForAnalytics">
                        <option value="">-- Select a Student for Deep Dive --</option>
                        @foreach (var student in classRoster)
                        {
                            <option value="@student.UniqueId">@student.Name (@student.UniqueId)</option>
                        }
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(selectedStudentForAnalytics))
                {
                    <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.05);">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 16px; font-weight: 600;">Semester Attendance Trajectory</span>
                            <span style="font-size: 20px; font-weight: 800; color: var(--success);">88%</span>
                        </div>
                        <div style="width: 100%; background: rgba(255,255,255,0.1); height: 8px; border-radius: 4px; margin-bottom: 20px; overflow: hidden;">
                            <div style="width: 88%; height: 100%; background: var(--success);"></div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                            <div style="background: var(--bg-base); padding: 15px; border-radius: var(--radius-sm);">
                                <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Total Classes Conducted</div>
                                <div style="font-size: 20px; font-weight: 700;">45</div>
                            </div>
                            <div style="background: var(--bg-base); padding: 15px; border-radius: var(--radius-sm);">
                                <div style="font-size: 12px; color: var(--text-secondary); text-transform: uppercase;">Total Classes Attended</div>
                                <div style="font-size: 20px; font-weight: 700; color: var(--faculty);">40</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- TAB 3: CLASS COMMUNICATIONS -->
        @if (currentTab == "Communications")
        {
            <div class="glass-panel">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; color: var(--faculty); font-size: 18px; font-weight: 600;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    Classroom Broadcast Center
                </div>
                <p style="color: var(--text-secondary); font-size: 13px; margin-bottom: 20px;">Messages will be dispatched directly to all student dashboards in your class <strong>(@primaryClass)</strong>.</p>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Broadcast Message Content</label>
                    <textarea class="glass-input" style="height: 120px; resize: vertical;" @bind="notificationMessage" placeholder="Type your classroom announcement or alert here..."></textarea>
                </div>

                <button class="btn btn-primary" style="background: var(--faculty); width: 100%;" @onclick="SendNotification">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    Broadcast to Class
                </button>
            </div>
        }

    </main>
</div>

<!-- ============================================== -->
<!-- OVERLAY MODAL: EDIT HISTORICAL ATTENDANCE CALENDAR -->
<!-- ============================================== -->
@if (showHistoryModal && activeHistoryStudent != null)
{
    <div class="modal-overlay">
        <div class="glass-panel" style="width: 500px; max-width: 90%; position: relative; padding: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                <div>
                    <h3 style="margin: 0 0 5px 0; font-size: 20px; color: var(--faculty);">Audit Attendance</h3>
                    <p style="margin: 0; font-size: 13px; color: var(--text-secondary);">@activeHistoryStudent.Name (@activeHistoryStudent.UniqueId)</p>
                </div>
                <button class="nav-btn" style="width: auto; padding: 8px; border: 1px solid rgba(255,255,255,0.1);" @onclick="() => showHistoryModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- Month Controls -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; background: rgba(0,0,0,0.2); padding: 10px; border-radius: var(--radius-md);">
                <button class="btn" style="padding: 5px 10px;" @onclick="() => ChangeHistoryMonth(-1)">&lt; Prev</button>
                <span style="font-weight: 700; font-size: 16px;">@historyMonthView.ToString("MMMM yyyy")</span>
                <button class="btn" style="padding: 5px 10px;" @onclick="() => ChangeHistoryMonth(1)">Next &gt;</button>
            </div>

            <!-- 7-Day Calendar Grid -->
            <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; margin-bottom: 20px;">
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Sun</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Mon</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Tue</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Wed</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Thu</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Fri</div>
                <div style="font-weight: bold; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">Sat</div>

                @{
                    var daysInMonth = DateTime.DaysInMonth(historyMonthView.Year, historyMonthView.Month);
                    var firstDay = new DateTime(historyMonthView.Year, historyMonthView.Month, 1);
                    int offset = (int)firstDay.DayOfWeek;
                }

                @for (int i = 0; i < offset; i++)
                {
                    <div></div> <!-- Empty padding slots -->
                }

                @for (int day = 1; day <= daysInMonth; day++)
                {
                    var currentDate = new DateTime(historyMonthView.Year, historyMonthView.Month, day);
                    bool isValidWorkingDay = attendanceEdits.ContainsKey(currentDate.Date);
                    bool isPresent = isValidWorkingDay && attendanceEdits[currentDate.Date];

                    <div class="calendar-day @(isValidWorkingDay ? "active" : "disabled") @(isValidWorkingDay ? (isPresent ? "present" : "absent") : "")"
                         @onclick="() => ToggleHistoryDay(currentDate.Date)">
                        @day
                    </div>
                }
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px;">
                <div style="font-size: 12px; color: var(--text-secondary);">
                    Red = Absent <br /> Green = Present
                </div>
                <div style="display: flex; gap: 10px;">
                    <button class="btn" style="background: rgba(255,255,255,0.05);" @onclick="() => showHistoryModal = false">Discard</button>
                    <button class="btn btn-primary" style="background: var(--faculty);" @onclick="SaveHistoryChanges">Save Records</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    string currentTab = "Overview";
    string statusMessage = "";

    // Class State
    string primaryClass = "";

    // Overview State
    int totalStudents = 0;
    int presentCount = 0;
    List<AppUser> classRoster = new List<AppUser>();
    List<AttendanceRecord> todaysRecords = new List<AttendanceRecord>();
    string csvExportPeriod = "Daily";

    // Analytics State
    string selectedStudentForAnalytics = "";

    // Communications State
    string notificationMessage = "";

    // ==========================================
    // HISTORICAL CALENDAR EDIT STATE
    // ==========================================
    bool showHistoryModal = false;
    AppUser? activeHistoryStudent = null;
    DateTime historyMonthView = DateTime.Today;
    Dictionary<DateTime, bool> attendanceEdits = new Dictionary<DateTime, bool>();

    // Academic Config limits
    DateTime academicStartDate = AcademicConfig.StartDate;
    string holidayListString = AcademicConfig.Holidays;

    protected override void OnInitialized()
    {
        if (GlobalState.CurrentUser == null || GlobalState.CurrentUser.Role != "Teacher")
        {
            NavManager.NavigateTo("/");
            return;
        }

        // Identify Teacher's Primary Class
        primaryClass = GetGroupName(GlobalState.CurrentUser.AssignedClass);
        LoadClassData();
    }

    void SetTab(string tabName)
    {
        currentTab = tabName;
        statusMessage = "";
    }

    string GetGroupName(string fullAssignment)
    {
        if (string.IsNullOrWhiteSpace(fullAssignment)) return "Unassigned";
        if (fullAssignment.Contains("|")) return fullAssignment.Split('|')[0].Trim();
        return fullAssignment.Trim();
    }

    void LoadClassData()
    {
        // STRICT BUT FLEXIBLE: Matches "TYBSc CS", but ignores the " | Roll: 22" at the end
        classRoster = Db.Users
            .Where(u => u.Role == "Student" && u.AssignedClass != null && u.AssignedClass.StartsWith(primaryClass))
            .OrderBy(u => u.UniqueId)
            .ToList();

        totalStudents = classRoster.Count;
        var today = DateTime.Today;

        todaysRecords = Db.AttendanceRecords
            .Where(a => a.Timestamp.Date == today)
            .ToList();

        var todaysPresentIds = todaysRecords.Select(a => a.StudentId).Distinct().ToList();
        presentCount = classRoster.Count(s => todaysPresentIds.Contains(s.UniqueId));
    }

    // --- MANUAL ATTENDANCE OVERRIDE (TODAY) ---
    void ToggleAttendance(string studentId, bool makePresent)
    {
        var today = DateTime.Today;
        var existingRecord = Db.AttendanceRecords.FirstOrDefault(r => r.StudentId == studentId && r.Timestamp.Date == today);

        if (makePresent && existingRecord == null)
        {
            var newRecord = new AttendanceRecord
            {
                StudentId = studentId,
                Timestamp = DateTime.Now,
                Status = "Present (Manual Override)",
                MarkedBy = GlobalState.CurrentUser?.Name ?? "Faculty"
            };
            Db.AttendanceRecords.Add(newRecord);
        }
        else if (!makePresent && existingRecord != null)
        {
            Db.AttendanceRecords.Remove(existingRecord);
        }

        Db.SaveChanges();
        LoadClassData();

        var student = classRoster.FirstOrDefault(s => s.UniqueId == studentId);
        statusMessage = $"Success: Attendance status for {student?.Name ?? studentId} updated to {(makePresent ? "Present" : "Absent")}.";
    }

    // ==========================================
    // HISTORICAL CALENDAR LOGIC
    // ==========================================
    void OpenHistoryModal(string studentId)
    {
        activeHistoryStudent = classRoster.FirstOrDefault(s => s.UniqueId == studentId);
        if (activeHistoryStudent == null) return;

        historyMonthView = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        LoadHistoryEditsForStudent();
        showHistoryModal = true;
    }

    void ChangeHistoryMonth(int offset)
    {
        historyMonthView = historyMonthView.AddMonths(offset);
    }

    void LoadHistoryEditsForStudent()
    {
        attendanceEdits.Clear();
        var existingRecords = Db.AttendanceRecords.Where(r => r.StudentId == activeHistoryStudent!.UniqueId).ToList();

        // Safely parse holidays
        var holidays = new List<DateTime>();
        if (!string.IsNullOrWhiteSpace(holidayListString))
        {
            holidays = holidayListString.Split(',')
                .Select(s => DateTime.TryParse(s.Trim(), out var dt) ? dt.Date : DateTime.MinValue)
                .Where(d => d != DateTime.MinValue)
                .ToList();
        }

        // Build a dictionary of every valid academic day up to today
        for (var d = academicStartDate.Date; d <= DateTime.Today; d = d.AddDays(1))
        {
            // Now skipping ONLY Sundays (Saturdays are included as valid class days)
            if (d.DayOfWeek == DayOfWeek.Sunday) continue;
            if (holidays.Contains(d)) continue;

            bool isPresent = existingRecords.Any(r => r.Timestamp.Date == d);
            attendanceEdits[d] = isPresent;
        }
    }

    void ToggleHistoryDay(DateTime dateClicked)
    {
        if (attendanceEdits.ContainsKey(dateClicked))
        {
            // Toggle red/green
            attendanceEdits[dateClicked] = !attendanceEdits[dateClicked];
        }
    }

    void SaveHistoryChanges()
    {
        var existingRecords = Db.AttendanceRecords.Where(r => r.StudentId == activeHistoryStudent.UniqueId).ToList();
        int changesMade = 0;

        foreach (var kvp in attendanceEdits)
        {
            var date = kvp.Key;
            var isMarkedPresent = kvp.Value;
            var existingRecord = existingRecords.FirstOrDefault(r => r.Timestamp.Date == date);

            if (isMarkedPresent && existingRecord == null)
            {
                // Teacher marked absent -> present
                Db.AttendanceRecords.Add(new AttendanceRecord
                {
                    StudentId = activeHistoryStudent.UniqueId,
                    Timestamp = new DateTime(date.Year, date.Month, date.Day, 9, 0, 0), // Insert simulated 9 AM punch
                    Status = "Present (Historical Override)",
                    MarkedBy = GlobalState.CurrentUser?.Name ?? "Faculty"
                });
                changesMade++;
            }
            else if (!isMarkedPresent && existingRecord != null)
            {
                // Teacher marked present -> absent
                Db.AttendanceRecords.Remove(existingRecord);
                changesMade++;
            }
        }

        Db.SaveChanges();
        statusMessage = $"Audit Saved: {changesMade} historical modifications applied to {activeHistoryStudent.Name}'s record.";
        showHistoryModal = false;
        LoadClassData(); // Refresh overview to ensure UI is in sync
    }

    // --- CSV ATTENDANCE EXPORT (Consolidated Class Report) ---
    async Task ExportRoster()
    {
        try
        {
            DateTime startDate = DateTime.Today;
            DateTime endDate = DateTime.Today.AddDays(1).AddTicks(-1);

            if (csvExportPeriod == "Weekly") startDate = DateTime.Today.AddDays(-7);
            if (csvExportPeriod == "Monthly") startDate = DateTime.Today.AddMonths(-1);

            var studentIds = classRoster.Select(s => s.UniqueId).ToList();

            var allRecords = Db.AttendanceRecords.ToList();
            var recordsToExport = allRecords
                .Where(r => studentIds.Contains(r.StudentId) && r.Timestamp >= startDate && r.Timestamp <= endDate)
                .OrderBy(r => r.Timestamp)
                .ToList();

            var csvBuilder = new System.Text.StringBuilder();
            csvBuilder.AppendLine("Roll Number,Student Name,Date,Status,Remarks");

            var sortedRoster = classRoster.OrderBy(s => s.UniqueId).ToList();

            foreach (var student in sortedRoster)
            {
                var studentRecs = recordsToExport.Where(r => r.StudentId == student.UniqueId).ToList();

                if (csvExportPeriod == "Daily")
                {
                    var rec = studentRecs.FirstOrDefault();
                    string dateStr = DateTime.Today.ToString("yyyy-MM-dd");
                    string status = rec != null ? "Present" : "Absent";
                    string remarks = rec != null ? $"Checked in at {rec.Timestamp:HH:mm:ss}" : "Unverified / Absent";
                    string cleanName = $"\"{student.Name}\"";

                    csvBuilder.AppendLine($"{student.UniqueId},{cleanName},{dateStr},{status},\"{remarks}\"");
                }
                else
                {
                    if (studentRecs.Count == 0)
                    {
                        string cleanName = $"\"{student.Name}\"";
                        csvBuilder.AppendLine($"{student.UniqueId},{cleanName},{startDate:yyyy-MM-dd} to {endDate:yyyy-MM-dd},No Records,\"No attendance logs found\"");
                    }
                    else
                    {
                        foreach (var rec in studentRecs)
                        {
                            string dateStr = rec.Timestamp.ToString("yyyy-MM-dd");
                            string status = "Present";
                            string remarks = $"Time In: {rec.Timestamp:HH:mm:ss}";
                            string cleanName = $"\"{student.Name}\"";

                            csvBuilder.AppendLine($"{student.UniqueId},{cleanName},{dateStr},{status},\"{remarks}\"");
                        }
                    }
                }
            }

            string cleanClassName = primaryClass.Replace(" ", "_").Replace("|", "");
            string fileName = $"{cleanClassName}_{csvExportPeriod}_Consolidated_Roster_{DateTime.Now:yyyyMMdd}.csv";

            await DownloadCsv(fileName, csvBuilder.ToString());
            statusMessage = $"{csvExportPeriod} consolidated class roster exported successfully as CSV.";
        }
        catch (Exception ex)
        {
            statusMessage = "Export Failed: " + ex.Message;
        }
    }

    private async Task DownloadCsv(string fileName, string csvContent)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
        var base64 = Convert.ToBase64String(bytes);

        var jsCode = $@"
            var a = document.createElement('a');
            a.href = 'data:text/csv;base64,' + '{base64}';
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ";

        await JS.InvokeVoidAsync("eval", jsCode);
    }

    // --- CLASSROOM BROADCAST CENTER ---
    void SendNotification()
    {
        if (string.IsNullOrWhiteSpace(notificationMessage))
        {
            statusMessage = "Broadcast content cannot be empty.";
            return;
        }

        var notification = new AppNotification
        {
            SenderName = GlobalState.CurrentUser?.Name ?? "Faculty",
            TargetId = "ALL",
            TargetClass = primaryClass, // Locked to teacher's class
            Message = notificationMessage,
            Timestamp = DateTime.Now
        };

        Db.Notifications.Add(notification);
        Db.SaveChanges();

        statusMessage = $"Classroom broadcast securely dispatched to entire cohort: {primaryClass}.";
        notificationMessage = "";
    }

    void SignOut()
    {
        GlobalState.Logout();
        NavManager.NavigateTo("/");
    }
